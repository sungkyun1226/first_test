                        <div class="space-y-4">
                            <div>
                                <label for="onHand" class="block text-sm font-medium text-gray-700">현재고 (On-Hand)</label>
                                <input type="number" id="onHand" value="130" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                            </div>
                            <div>
                                <label for="onOrder" class="block text-sm font-medium text-gray-700">입고예정 (On-Order)</label>
                                <input type="number" id="onOrder" value="50" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                            </div>
                            <div>
                                <label for="demand" class="block text-sm font-medium text-gray-700">수요 (Demand)</label>
                                <input type="number" id="demand" value="20" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                            </div>
                        </div>
                        <div class="mt-6 bg-gray-100 p-4 rounded-lg text-center">
                            <p class="text-sm font-medium text-gray-500">순 흐름 (Net Flow)</p>
                            <p class="text-sm text-gray-500">(현재고 + 입고예정 - 수요)</p>
