                     <div id="bom-diagram" class="space-y-4 flex flex-col items-center text-sm">
                        <div data-item="P1" class="bom-item border-2 border-gray-400 bg-gray-100 rounded-md px-4 py-2 cursor-pointer w-32 text-center">완제품: P1</div>
                        <div class="w-px h-6 bg-gray-400"></div>
                        <div class="flex space-x-12">
                            <div class="flex flex-col items-center space-y-4">
                                <div data-item="M1" class="bom-item border-2 border-blue-400 bg-blue-100 rounded-md px-4 py-2 cursor-pointer w-32 text-center">반제품: M1</div>
                                <div class="w-px h-6 bg-gray-400"></div>
