    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Navigation scroll behavior
            const navLinks = document.querySelectorAll('.nav-link');
            const sections = document.querySelectorAll('section');

            const observerOptions = {
                root: null,
                rootMargin: '0px',
                threshold: 0.4
            };

            const observer = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        navLinks.forEach(link => {
                            link.classList.toggle('active', link.getAttribute('href').substring(1) === entry.target.id);
                        });
                    }
                });
            }, observerOptions);

            sections.forEach(section => {
                observer.observe(section);
            });
            
            navLinks.forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });

            // Section 1: Bullwhip Effect Chart
            const bullwhipCtx = document.getElementById('bullwhipChart').getContext('2d');
            const initialData = {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6', 'Week 7', 'Week 8'],
                customer: [100, 102, 98, 100, 105, 95, 100, 103],
            };

            function generateUpstreamData(customerData, factor, lag) {
                let upstreamData = [];
                for (let i = 0; i < customerData.length; i++) {
                    let base = i > lag ? customerData[i - lag] : 100;
                    let noise = (Math.random() - 0.5) * factor;
                    upstreamData.push(Math.round(base * (1 + noise)));
                }
                return upstreamData;
            }

            let bullwhipChart = new Chart(bullwhipCtx, {
                type: 'line',
                data: {
                    labels: initialData.labels,
                    datasets: [{
                        label: '고객 수요',
                        data: initialData.customer,
                        borderColor: '#3B82F6',
                        backgroundColor: '#3B82F6_33',
                        tension: 0.1,
                        borderWidth: 3
                    }, {
                        label: '소매점 주문',
                        data: generateUpstreamData(initialData.customer, 0.1, 1),
                        borderColor: '#FBBF24',
                        backgroundColor: '#FBBF24_33',
                        tension: 0.1,
                        borderWidth: 2
                    }, {
                        label: '제조사 생산',
                        data: generateUpstreamData(initialData.customer, 0.3, 2),
                        borderColor: '#EF4444',
                        backgroundColor: '#EF4444_33',
                        tension: 0.1,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: false,
                            title: { display: true, text: '수량' }
                        }
                    },
                    plugins: {
                        title: { display: true, text: '수요 변동에 따른 공급망 주문량 증폭 현상' },
                        tooltip: { mode: 'index', intersect: false }
                    }
                }
            });

            const demandSlider = document.getElementById('demandSlider');
            const demandValue = document.getElementById('demandValue');
            demandSlider.addEventListener('input', (e) => {
                const sliderValue = parseInt(e.target.value);
                demandValue.textContent = `${sliderValue}%`;
                
                const newCustomerData = initialData.customer.map(d => d * (1 + sliderValue / 100));
                bullwhipChart.data.datasets[0].data = newCustomerData;
                bullwhipChart.data.datasets[1].data = generateUpstreamData(newCustomerData, 0.1, 1);
                bullwhipChart.data.datasets[2].data = generateUpstreamData(newCustomerData, 0.3, 2);
                bullwhipChart.update();
            });

            // Section 2: BOM Interaction
            const bomItems = document.querySelectorAll('.bom-item');
            const bomFeedback = document.getElementById('bom-feedback');
            let bufferedItem = null;
            bomItems.forEach(item => {
                item.addEventListener('click', () => {
                    bomItems.forEach(i => {
                        i.innerHTML = i.innerHTML.replace(' 📦', '');
                        i.classList.remove('ring-4', 'ring-offset-2', 'ring-blue-500');
                    });
                    const itemName = item.dataset.item;
                    item.innerHTML += ' 📦';
                    item.classList.add('ring-4', 'ring-offset-2', 'ring-blue-500');
                    bufferedItem = itemName;
                    bomFeedback.textContent = `${itemName}에 버퍼를 설정하여 수요 변동성을 차단합니다.`;
                });
            });

            // Section 3: Buffer Simulation
            const onHandInput = document.getElementById('onHand');
            const onOrderInput = document.getElementById('onOrder');
            const demandInput = document.getElementById('demand');
            const netFlowValueEl = document.getElementById('netFlowValue');
            const bufferStatusEl = document.getElementById('bufferStatus');
            const netFlowIndicator = document.getElementById('net-flow-indicator');

            const redZoneEl = document.getElementById('red-zone');
            const yellowZoneEl = document.getElementById('yellow-zone');
            const greenZoneEl = document.getElementById('green-zone');
            
            const redVal = 75, yellowVal = 200, greenVal = 140;
            const totalBuffer = redVal + yellowVal + greenVal;

            function updateBuffer() {
                const onHand = parseInt(onHandInput.value) || 0;
                const onOrder = parseInt(onOrderInput.value) || 0;
                const demand = parseInt(demandInput.value) || 0;

                const netFlow = onHand + onOrder - demand;
                netFlowValueEl.textContent = netFlow;
                
                const topOfRed = redVal;
                const topOfYellow = redVal + yellowVal;
                
                let status = '';
                let color = '';

                if (netFlow <= topOfRed) {
                    status = '🚨 재고 위험! 즉시 보충 필요 (Red Zone)';
                    color = 'text-red-600';
                } else if (netFlow <= topOfYellow) {
                    status = '⚠️ 재고 보충 필요 (Yellow Zone)';
                    color = 'text-yellow-600';
                } else {
                    status = '✅ 재고 적정 수준 (Green Zone)';
                    color = 'text-green-600';
                }
                bufferStatusEl.textContent = status;
                bufferStatusEl.className = `mt-4 text-lg font-bold h-12 ${color}`;

                const netFlowPercentage = Math.max(0, Math.min(100, (netFlow / totalBuffer) * 100));
                netFlowIndicator.style.bottom = `${netFlowPercentage}%`;
            }

            [onHandInput, onOrderInput, demandInput].forEach(input => {
                input.addEventListener('input', updateBuffer);
            });
            updateBuffer(); // Initial call
            
            // Section 4: Impact Chart
            const impactCtx = document.getElementById('impactChart').getContext('2d');
            new Chart(impactCtx, {
                type: 'bar',
                data: {
                    labels: ['재고 수준', '납기 준수율', '결품률'],
                    datasets: [{
                        label: '전통적 MRP',
                        data: [100, 90, 15],
                        backgroundColor: '#9CA3AF',
                    }, {
                        label: 'DDMRP 도입 후',
                        data: [60, 99, 3],
                        backgroundColor: '#3B82F6',
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: '성과 지표 (%)' }
                        }
                    },
                    plugins: {
                        title: { display: true, text: 'DDMRP 도입 전후 핵심 성과 지표(KPI) 비교' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += context.parsed.y + '%';
                                    }
                                    return label;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>
